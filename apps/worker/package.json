{
  "name": "@aidp/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-env.mjs tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
