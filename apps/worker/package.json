    "@aidp/db": "workspace:*",
    "@aidp/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aidp/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
