# Development configuration, for `docker compose up` and `pnpm dev`. Copy to apps/api/.env.
# Production does NOT read this file: deploy/generate-env.sh writes deploy/.env and
# deploy/compose.prod.yml names every variable explicitly. See docs/DEPLOY.md.
PORT=4000
HOST=0.0.0.0

# Development connects as the owner, which bypasses the row-level security policies. That is
# tolerable locally and is refused in production, where the app connects as app_api and
# deploy/preflight.sh checks it. To exercise the production path locally, give app_api a login
# (APP_DB_PASSWORD below, read by `pnpm --filter @aidp/db bootstrap`) and point DATABASE_URL at
# postgresql://app_api:<password>@localhost:5432/ai_discovery, leaving migrations on the owner.
DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery
APP_DB_PASSWORD=                    # optional here, required in production: gives app_api a login
PLATFORM_ENCRYPTION_KEY=            # 32 random bytes, base64: openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY_PREVIOUS=   # only during a rotation: the key being retired (docs/OPERATIONS.md, crypto.rekey)
AUTH_SECRET=                        # same value as the web app's AUTH_SECRET
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
EMAIL_SMTP_URL=                     # smtp://user:pass@host:587 ; empty logs emails to the console
EMAIL_FROM=no-reply@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. http://tempo:4318 ; empty disables tracing export (the API and the worker both export)
METRICS_PORT=                       # e.g. 9464 (the worker uses 9465): serves Prometheus /metrics on that port; empty or 0 is off
OPS_STATE_DIR=                      # the shared status volume (backup status, worker heartbeat, erasure ledger); empty in development
AIDP_VERSION=                       # the running release, shown on the operator health page
LOG_LEVEL=info

# Network security (docs/DEPLOY.md, "Who may connect to what")
TRUST_PROXY_HOPS=1                  # proxies in front of the API that write X-Forwarded-For
EGRESS_MODE=strict                  # permissive is for tests and is refused in production
EGRESS_ALLOW_HOSTS=                 # hostnames a platform provider may reach on a private address, e.g. litellm,kroki
KROKI_URL=                          # diagram renderer for PDF export and the diagram editor, e.g. http://kroki:8000 (its host goes in EGRESS_ALLOW_HOSTS); empty prints diagrams as source
# Operator alerts (docs/OPERATIONS.md). Both optional; with neither, an alert still lands in the
# OpsAlert table and the operator address falls back to the bootstrap operator's email.
ALERT_EMAIL=                        # where operator alerts are emailed
ALERT_WEBHOOK_URL=                  # an ntfy topic URL, a Slack incoming webhook, or a generic JSON endpoint
ALERT_WEBHOOK_FORMAT=               # ntfy | slack | generic (default ntfy)

# Outbound model-call limits in milliseconds (packages/ai/src/providers/resilience.ts). Empty keeps
# the defaults: 120000 total, 20000 to first token, 30000 idle, 2 retries.
PROVIDER_TIMEOUT_MS=
PROVIDER_FIRST_TOKEN_TIMEOUT_MS=
PROVIDER_IDLE_TIMEOUT_MS=
PROVIDER_MAX_RETRIES=

# First-run bootstrap used by `docker compose up` (idempotent)
BOOTSTRAP_OPERATOR_EMAIL=you@example.com
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_TENANT_NAME=First tenant
ANTHROPIC_API_KEY=                  # optional: creates a platform Anthropic provider with default routes
OPENAI_API_KEY=                     # optional: speaks, embeds, and streams captions; transcription also works on-server (below)
OPENAI_BASE_URL=                    # optional: point the OpenAI-compatible calls at another endpoint (an EU region, a proxy)
OPENROUTER_API_KEY=                 # optional: creates a platform OpenRouter provider with default routes
MODEL_CACHE_DIR=                    # optional: where the on-server Whisper models are cached; empty uses the default
SPEECH_MODEL_IDLE_MINUTES=          # optional: minutes the on-server Whisper model stays in memory after the last recording
AUTH_GOOGLE_ID=                     # optional: Google sign-in for the web app
AUTH_GOOGLE_SECRET=
