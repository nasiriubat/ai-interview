# Base URL of the API (without /api/v1). Used by server components and route handlers.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth.js. Generate with: openssl rand -base64 32. Must equal the API's secret so it can decode the session JWT.
AUTH_SECRET=

# Google OAuth (Auth.js reads these names automatically)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic links (Nodemailer). smtp://user:pass@host:587 or a local catcher such as smtp://localhost:1025
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=no-reply@example.com
