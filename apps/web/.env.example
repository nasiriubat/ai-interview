# Base URL of the API (without /api/v1). Used by server components and route handlers.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Live voice (FR-30a) is the one call the browser makes itself: a WebSocket cannot go through the
# Next.js proxy, so Caddy forwards /api/v1/p/session/live to the API and this is left empty in
# production (same origin, so the participant cookie travels). In development the API is on another
# port, so point this at it. ws:// locally, wss:// behind TLS.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4000/api/v1/p/session/live

# Public landing page (/): where "Request a workspace" writes to. Leave empty and the page shows
# sign-in only, with no mail link. Read at runtime.
NEXT_PUBLIC_CONTACT_EMAIL=

# Auth.js. Generate with: openssl rand -base64 32. Must equal the API's secret so it can decode the session JWT.
AUTH_SECRET=

# Google OAuth (Auth.js reads these names automatically)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email magic links (Nodemailer). smtp://user:pass@host:587 or a local catcher such as smtp://localhost:1025
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=no-reply@example.com
