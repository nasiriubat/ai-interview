{
  "name": "ai-discovery-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @aidp/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @aidp/shared build && pnpm -r test",
    "lint": "pnpm -r lint",
    "check": "pnpm build && pnpm -r typecheck && pnpm -r test"
  }
}
