{
  "name": "ai-discovery-platform",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "lint": "eslint packages apps evals",
    "check": "tsx scripts/check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres && DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery pnpm --filter @aidp/db exec prisma migrate deploy && echo 'export DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.70.0"
  },
  "type": "module"
}
