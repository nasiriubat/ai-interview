{
  "name": "@aidp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-lock.mjs db-build -- pnpm run build:lib",
    "build:lib": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:dev": "node ../../scripts/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node ../../scripts/with-env.mjs prisma migrate deploy",
    "seed": "node ../../scripts/with-env.mjs tsx seeds/seed.ts",
    "bootstrap": "node ../../scripts/with-env.mjs tsx seeds/bootstrap.ts",
    "build:seeds": "tsc -p tsconfig.seeds.json",
    "bootstrap:prod": "node dist-seeds/seeds/bootstrap.js"
  },
  "dependencies": {
    "@aidp/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "zod": "^4.0.0",
    "@aidp/ai": "workspace:*",
    "@aidp/core": "workspace:*",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@aidp/testing": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
