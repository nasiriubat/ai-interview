// Spec v1.1 section 9. Every tenant-owned row carries companyId (FR-01).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Tenancy and identity ----------

model Company {
  id                 String   @id @default(cuid())
  name               String
  region             String   @default("eu")
  monthlyBudgetCents Int      @default(0)
  status             String   @default("active") // active | suspended
  createdAt          DateTime @default(now())

  users             User[]
  participants      Participant[]
  templates         InterviewTemplate[]
  campaigns         Campaign[]
  sessions          Session[]
  attachments       Attachment[]
  chunks            AttachmentChunk[]
  facts             Fact[]
  providers         Provider[]
  routes            Route[]
  budgets           Budget[]
  fallbackRoutes    FallbackRoute[]
  statements        TenantStatement[]
  llmCalls          LlmCall[]
  auditLogs         AuditLog[]
  opsAlerts         OpsAlert[]
  usageCounters     UsageCounter[]
  errorGroups       ErrorGroup[]
  errorOccurrences  ErrorOccurrence[]
  campaignDocuments CampaignDocument[]
}

model User {
  id               String    @id @default(cuid())
  companyId        String
  email            String    @unique // lower-case, one tenant per address (D-84); a CHECK enforces the case
  name             String?
  role             String // platform_operator | admin | member
  createdAt        DateTime  @default(now())
  /// Set when staff access is withdrawn. A disabled user's tokens stop resolving at once (D-161).
  disabledAt       DateTime?
  /// Tokens issued before this instant are refused, so disabling ends sessions already open and
  /// re-enabling does not bring them back: the person signs in again.
  tokensValidAfter DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  participants Participant[]
  sessions     Session[]     @relation("SessionOwner")
  campaigns    Campaign[]

  @@index([companyId])
}

/// A person taking part in a campaign. Anonymous participants have no user and only the
/// fields the template asked for (FR-04).
model Participant {
  id         String   @id @default(cuid())
  companyId  String
  campaignId String? // null for a person invited into a requirements session (contract 18)
  userId     String?
  fields     Json     @default("{}")
  tokenHash  String   @unique
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  sessions Session[]

  @@index([companyId, campaignId])
}

// ---------- Templates (FR-60 to FR-66) ----------

model InterviewTemplate {
  id                String   @id @default(cuid())
  companyId         String? // null = platform seeded
  key               String
  version           Int      @default(1)
  name              String
  language          String   @default("en")
  objective         String
  privacyMode       String // identified | anonymous | participant_choice
  participantFields Json     @default("[]")
  pathSelection     String   @default("none") // none | technical_or_not
  contextBlock      Json     @default("[]")
  coverageAreas     Json     @default("[]")
  aiInstructions    String   @default("")
  adaptivity        Json     @default("{}")
  widgetPolicy      Json     @default("{}")
  issueDetection    Json     @default("{}")
  outputs           Json     @default("[]")
  analysisEnabled   Boolean  @default(false)
  chainToKey        String?
  chainMapping      Json?
  closingQuestion   String   @default("Is there anything important I did not ask about?")
  endSummary        Boolean  @default(true)
  maxTurns          Int      @default(60)
  maxAssistantChars Int      @default(600)
  status            String   @default("draft") // draft | published | archived
  createdById       String?
  createdAt         DateTime @default(now())

  company   Company?   @relation(fields: [companyId], references: [id])
  campaigns Campaign[]
  sessions  Session[]

  @@unique([companyId, key, version])
  @@index([companyId])
}

// ---------- Campaigns and sessions ----------

model Campaign {
  id                  String              @id @default(cuid())
  companyId           String
  templateId          String
  name                String
  participationMode   String // identified | anonymous | participant_choice
  linkTokenHash       String              @unique
  verification        String              @default("email_code") // invitation | email_code | open
  allowedEmailDomains Json                @default("[]")
  expiresAt           DateTime?
  maxTurns            Int                 @default(60)
  completionThreshold Int                 @default(5)
  weights             Json                @default("{}")
  status              String              @default("draft") // draft | open | analyzing | closed
  createdById         String
  createdAt           DateTime            @default(now())
  invitations         Invitation[]
  emailHashes         CampaignEmailHash[]
  emailCodes          EmailCode[]

  company      Company            @relation(fields: [companyId], references: [id])
  template     InterviewTemplate  @relation(fields: [templateId], references: [id])
  createdBy    User               @relation(fields: [createdById], references: [id])
  participants Participant[]
  sessions     Session[]
  analyses     Analysis[]
  clusterEdits ClusterEdit[]
  llmCalls     LlmCall[]
  documents    CampaignDocument[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model Session {
  id              String    @id @default(cuid())
  companyId       String
  templateId      String
  campaignId      String?
  participantId   String?
  ownerUserId     String?
  sourceKind      String    @default("campaign") // campaign | text | handoff
  handoff         Json?
  title           String    @default("") // requirements sessions: the product or idea name
  specEdits       Json      @default("{}") // requirements sessions: owner edits by section key (FR-23)
  invitations     Json      @default("[]") // requirements sessions: external invitations (contract 18)
  status          String    @default("created") // created | consented | active | paused | completed | deleted
  consentVersion  String?
  consentedAt     DateTime?
  state           Json      @default("{}")
  summary         String    @default("")
  path            String? // technical | nontechnical
  modePreference  String    @default("chat") // chat | options | voice
  turnLockedAt    DateTime? // set while a turn is running; guards against concurrent turns
  templateVersion Int       @default(1)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  /// Last write to the row: every turn rewrites `state`, so this is the session's last activity (D-79).
  updatedAt       DateTime  @default(now()) @updatedAt
  /// The engine raised a hostility or distress flag (D-173). The first flag wins; later ones are events only.
  flagged         Boolean   @default(false)
  /// Model prose: returned only to a viewer who may read the transcript.
  flagReason      String?
  flaggedAt       DateTime?
  flagAckedAt     DateTime?
  flagAckedBy     String?
  /// The participant gave their identity (false: anonymous, or not a campaign interview). Set at consent.
  identified      Boolean   @default(false)

  company     Company           @relation(fields: [companyId], references: [id])
  template    InterviewTemplate @relation(fields: [templateId], references: [id])
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])
  participant Participant?      @relation(fields: [participantId], references: [id])
  owner       User?             @relation("SessionOwner", fields: [ownerUserId], references: [id])
  messages    Message[]
  events      SessionEvent[]
  attachments Attachment[]
  facts       Fact[]
  specs       SpecVersion[]
  llmCalls    LlmCall[]
  invitation  Invitation?

  // Children carry (id, companyId) as a composite foreign key, so a row can never name a tenant
  // other than its parent's (migration 0016, D-140).
  @@unique([id, companyId])
  @@index([companyId, campaignId])
  @@index([companyId, campaignId, status])
  @@index([companyId, ownerUserId])
  @@index([companyId, campaignId, flagged])
}

model Message {
  id             String   @id @default(cuid())
  /// Denormalised from the session so the row carries its own tenant fence (migration 0016, D-140).
  companyId      String
  sessionId      String
  seq            Int
  role           String // user | assistant
  modality       String   @default("text") // text | voice | dictated | file | widget
  content        String
  widget         Json? // Widget offered with an assistant message
  widgetResponse Json? // WidgetResponse recorded with a user message
  areaKey        String?
  createdAt      DateTime @default(now())

  session     Session      @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)
  attachments Attachment[]

  @@unique([sessionId, seq])
}

/// Append-only (FR-51). state_delta, finding, attachment, admin_note, system.
model SessionEvent {
  id        String   @id @default(cuid())
  companyId String
  sessionId String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([sessionId, seq])
}

model Attachment {
  id            String   @id @default(cuid())
  companyId     String
  sessionId     String
  messageId     String?
  kind          String // audio | document | image
  filename      String
  mime          String
  sizeBytes     Int
  storageKey    String
  extractedText String?
  summary       String?
  createdAt     DateTime @default(now())

  // Ingestion is a job, so an attachment exists before its text does (FR-31). The participant is
  // shown this rather than an attachment that silently never becomes useful.
  status     String    @default("pending") // pending | ready | failed
  error      String?
  ingestedAt DateTime?

  // Audio only (FR-30). durationMs drives the player and the per-second transcription cost;
  // confidence is one of the three voice signals the spec asks to trace per turn.
  durationMs Int?
  confidence Float?

  company Company           @relation(fields: [companyId], references: [id])
  session Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message Message?          @relation(fields: [messageId], references: [id])
  chunks  AttachmentChunk[]

  @@index([companyId, sessionId])
  @@index([companyId, status])
}

/// One retrievable piece of an ingested document (FR-31). The interview carries the attachment's
/// summary in context and recalls chunks on demand, so a 40-page PDF costs a summary per turn
/// rather than 40 pages per turn.
///
/// `embedding` is null whenever no `embedding` route is configured, which is the common case on a
/// provider that serves no embedding models. Recall then scores the same chunk text lexically,
/// so the feature degrades rather than disappears.
model AttachmentChunk {
  id           String                       @id @default(cuid())
  companyId    String
  attachmentId String
  seq          Int
  text         String
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, seq])
  @@index([companyId, attachmentId])
}

// ---------- Facts, analysis, opportunities ----------

model Fact {
  id               String                       @id @default(cuid())
  companyId        String
  sessionId        String
  kind             String // task | process | information_flow | pain_point | opportunity_candidate | spec_field
  payload          Json
  embedding        Unsupported("vector(1536)")?
  extractorVersion String
  extractedAt      DateTime                     @default(now())
  /// Highest message sequence of the extraction batch that produced this fact. With `ordinal` it
  /// is the idempotency key: replaying a batch cannot write its facts twice (D-100).
  batchEndSeq      Int
  /// Position within that batch.
  ordinal          Int
  /// The language of the template the fact was extracted under (D-177); null when unknown.
  language         String?

  company  Company               @relation(fields: [companyId], references: [id])
  session  Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence OpportunityEvidence[]

  @@unique([sessionId, batchEndSeq, ordinal])
  @@unique([id, companyId])
  @@index([companyId, sessionId])
}

model Analysis {
  id          String    @id @default(cuid())
  companyId   String
  campaignId  String
  version     Int
  status      String    @default("queued") // queued | running | done | failed
  preliminary Boolean   @default(false)
  stats       Json      @default("{}")
  /// Every cluster of this run before administrator edits, as { key, name, summary, factIds }. An
  /// edit run (merge, split, undo) starts from these instead of clustering again (D-200). Never
  /// returned by the API: it is a list of fact ids.
  clusters    Json      @default("[]")
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  campaign      Campaign      @relation(fields: [campaignId, companyId], references: [id, companyId])
  opportunities Opportunity[]
  reports       Report[]

  @@unique([campaignId, version])
  @@unique([id, companyId])
}

/// An administrator's merge or split of clusters (FR-18), stored against fact ids so it can be
/// applied to a later clustering of the same facts (D-200). Revoked, never deleted: undo is an edit.
model ClusterEdit {
  id         String    @id @default(cuid())
  companyId  String
  campaignId String
  op         String // merge | split
  payload    Json // ClusterEditPayload
  createdBy  String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  campaign Campaign @relation(fields: [campaignId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, campaignId, revokedAt])
}

model Opportunity {
  id                String   @id @default(cuid())
  companyId         String
  analysisId        String
  title             String
  summary           String
  solutionClass     String // ai | automation | software | process | none
  factors           Json // seven factors, each { score, rationale }
  rationale         String
  rankScore         Float
  status            String   @default("new") // new | shortlisted | promoted | dismissed
  clusterKey        String
  adminOverride     Json?
  stats             Json     @default("{}") // ClusterStats
  dataNeeded        Json     @default("[]")
  risks             Json     @default("[]")
  whyNotAi          String?
  promotedSessionId String?
  /// Every fact in the cluster, not only the twelve evidence rows. Internal; never returned.
  factIds           Json     @default("[]")
  /// problem | works_well (D-479): a works-well item is "no change recommended" and ranks last.
  basis             String   @default("problem")
  /// The member facts the counts, quotes and evidence come from (D-479); empty = every member. Internal.
  supportFactIds    Json     @default("[]")
  createdAt         DateTime @default(now())

  analysis Analysis              @relation(fields: [analysisId, companyId], references: [id, companyId], onDelete: Cascade)
  evidence OpportunityEvidence[]

  @@unique([id, companyId])
  @@index([analysisId, rankScore])
}

model OpportunityEvidence {
  companyId     String
  opportunityId String
  factId        String
  snippet       String
  anonymized    Boolean @default(true)
  /// quote (verbatim, found in the cited transcript) | paraphrase | unverified (written before D-478)
  kind          String  @default("unverified")

  opportunity Opportunity @relation(fields: [opportunityId, companyId], references: [id, companyId], onDelete: Cascade)
  fact        Fact        @relation(fields: [factId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([opportunityId, factId])
}

model Report {
  id             String    @id @default(cuid())
  companyId      String
  analysisId     String
  version        Int
  markdown       String
  sections       Json      @default("[]")
  pdfStorageKey  String?
  createdAt      DateTime  @default(now())
  /// draft | reviewed (D-478). A new run is a draft; an edit of its opportunities returns it to draft.
  reviewStatus   String    @default("draft")
  /// Who marked it reviewed: the user id (also in the audit log) and their name as it was then.
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  analysis Analysis @relation(fields: [analysisId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([analysisId, version])
}

/// A generated specification (spec 05, contract 18). Versions are kept; reopening creates a new one.
model SpecVersion {
  id         String    @id @default(cuid())
  companyId  String
  sessionId  String
  version    Int
  label      String?
  status     String    @default("done") // queued | running | done | failed
  error      String?
  spec       Json // SpecDocument
  specMd     String
  bundle     Json // AgentBundle
  issues     Json      @default("[]") // Finding[] open at generation time
  stats      Json      @default("{}")
  createdBy  String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@index([companyId])
}

/// Personal one-time links and email-code bindings (FR-10, FR-04). One session per invitation.
model Invitation {
  id             String    @id @default(cuid())
  companyId      String
  campaignId     String
  emailHash      String // salted hash; the plain email is kept only when the campaign is identified
  email          String?
  tokenHash      String    @unique
  status         String    @default("pending") // pending | sent | opened | bound | revoked | expired
  sessionId      String?   @unique
  sentAt         DateTime?
  openedAt       DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  /// Reminders sent for this invitation, and when the last went out (spec 07: reminders sent).
  reminderCount  Int       @default(0)
  lastRemindedAt DateTime?

  campaign Campaign @relation(fields: [campaignId, companyId], references: [id, companyId], onDelete: Cascade)
  session  Session? @relation(fields: [sessionId, companyId], references: [id, companyId])

  @@unique([campaignId, emailHash])
  @@unique([sessionId, companyId])
  @@index([companyId])
}

/// Uniqueness record for anonymous share links: proves an email responded without linking it to a session.
model CampaignEmailHash {
  companyId  String
  campaignId String
  emailHash  String
  /// Where to find the participant again, sealed under a key only the returning person can
  /// supply (the address they type, or the invitation token). Nothing else in the database
  /// connects this row to a session (D-142).
  resumeSeal String?
  /// A keyed tag of (campaign, participant), computable only with the platform key. It lets a
  /// participant's deletion find and remove this row without any stored pointer from the
  /// participant to it (D-142).
  ownerTag   String?
  /// Day granularity on anonymous campaigns, so the row cannot be matched to a session by time.
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId, companyId], references: [id, companyId], onDelete: Cascade)

  @@id([campaignId, emailHash])
  @@index([campaignId, ownerTag])
}

/// Short-lived email verification codes for share links.
model EmailCode {
  id         String   @id @default(cuid())
  companyId  String
  campaignId String
  emailHash  String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([campaignId, emailHash])
}

/// Settings catalog values by scope (packages/shared settings.ts defines keys and defaults).
model Setting {
  id        String   @id @default(cuid())
  scope     String // platform | tenant | template | campaign
  scopeId   String   @default("") // empty for platform
  /// The owning tenant, derived by a trigger from the scope (NULL: platform rows, readable by
  /// every tenant and writable only by the system context). Migration 0017, D-141.
  companyId String?
  key       String
  value     Json
  version   Int      @default(1)
  changedBy String?
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, key])
  @@index([companyId])
}

/// Pending Auth.js magic-link verification tokens (FR-01, D-56).
///
/// Platform-level, not tenant-owned: the token is minted from an email address alone, before
/// anyone knows which company it belongs to. So it carries no `companyId`, stays out of
/// `SCOPED_MODELS`, and is deliberately outside the row-level-security policy set in migration
/// 0008. The web app reaches it only through `/internal/auth/verification-tokens` on the API.
model VerificationToken {
  identifier String
  /// Already a hash. Auth.js hashes the magic-link token with AUTH_SECRET before handing it to
  /// the adapter: the plaintext goes in the email, the digest comes here. Do not hash it again,
  /// or `useVerificationToken` will never find the row it just wrote.
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

/// Public branding files of the platform itself: today only the site logo (D-432).
///
/// Platform-level, not tenant-owned, and deliberately outside row-level security like
/// `VerificationToken`: the bytes are served to anyone at `GET /public/branding/logo`, so there is
/// nothing a tenant fence would protect. Only the platform operator writes it. `version` is a
/// content hash, so it is also the cache key a browser keeps the image under.
model PlatformAsset {
  key         String   @id
  contentType String
  bytes       Bytes
  sizeBytes   Int
  width       Int
  height      Int
  version     String
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// Tenant overrides and canaries of the versioned prompt files shipped in packages/ai.
model PromptVersion {
  id            String    @id @default(cuid())
  companyId     String?
  key           String
  version       Int
  body          String
  canaryShare   Float     @default(0) // 0..1 share of sessions using this version
  active        Boolean   @default(false)
  createdBy     String?
  createdAt     DateTime  @default(now())
  /// Why the version exists, in the author's words.
  note          String?
  /// When the version last became active, and when it last stopped being.
  activatedAt   DateTime?
  deactivatedAt DateTime?
  /// The version this one was edited from; null when it started from the shipped prompt.
  parentVersion Int?

  @@unique([companyId, key, version])
  @@index([companyId, key])
}

// ---------- Providers, routing, cost (FR-40 to FR-49) ----------

model Provider {
  id         String   @id @default(cuid())
  companyId  String? // null = platform-level
  kind       String
  name       String
  baseUrl    String?
  apiKeyEnc  String
  /// Legacy plaintext custom headers. Emptied by the backfill at boot; `headersEnc` replaces it
  /// and the column is dropped in a follow-up migration (D-147).
  headers    Json     @default("{}")
  /// Custom headers as one encrypted JSON object, like `apiKeyEnc`; "" means none.
  headersEnc String   @default("")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  company        Company?        @relation(fields: [companyId], references: [id])
  prices         ModelPrice[]
  routes         Route[]
  fallbackRoutes FallbackRoute[]
  llmCalls       LlmCall[]

  @@index([companyId])
}

model ModelPrice {
  id                 String   @id @default(cuid())
  /// Derived by a trigger from the provider (NULL: a platform provider's price). Migration 0017.
  companyId          String?
  providerId         String
  model              String
  inputPerMtok       Float
  cachedInputPerMtok Float
  outputPerMtok      Float
  /// USD per minute of audio (speech-to-text). Migration 0023.
  audioPerMinute     Float?
  /// USD per million characters (text-to-speech). Migration 0023.
  ttsPerMChars       Float?
  source             String // seed | admin | provider
  updatedAt          DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
  @@index([companyId])
}

model Route {
  id              String  @id @default(cuid())
  companyId       String? // null = platform default
  purpose         String
  providerId      String
  model           String
  effort          String?
  maxOutputTokens Int
  batchAllowed    Boolean @default(false)

  company  Company? @relation(fields: [companyId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([companyId, purpose])
}

/// The route used when a purpose's primary provider is down (D-228). A sibling of Route rather than
/// a tier column on it: every existing reader of Route assumes one row per (company, purpose).
model FallbackRoute {
  id              String  @id @default(cuid())
  companyId       String? // null = platform default
  purpose         String
  providerId      String
  model           String
  effort          String?
  maxOutputTokens Int

  company  Company? @relation(fields: [companyId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([companyId, purpose])
}

/// One month of a tenant's usage and cost, frozen when the month closes (D-224). Invoicing reads
/// this, so it survives the retention sweep that later purges the ledger rows it summarises.
model TenantStatement {
  id          String   @id @default(cuid())
  companyId   String
  month       String // yyyy-mm
  generatedAt DateTime @default(now())
  currency    String   @default("USD")
  lines       Json
  totals      Json
  counts      Json

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, month])
}

/// What was erased on purpose, so that a restore from an older backup can erase it again (D-226).
/// Ids only. `companyId` is a plain column, not a relation: the row outlives the tenant.
model ErasureLedger {
  id          String   @id @default(cuid())
  kind        String // tenant | session
  targetId    String
  companyId   String
  erasedAt    DateTime @default(now())
  requestedBy String?

  @@unique([kind, targetId])
}

/// A fixed-window counter for abuse limits on open links and the email-code flow (D-261). One row
/// per tenant, subject and window; incremented with an atomic upsert so the count is shared by
/// every API replica and survives a restart. `key` names the subject (a campaign id, or a keyed
/// hash of a client address: never an address itself) and carries no personal data. Rows older
/// than two days are swept by the retention job.
/// Background material the organisation gives a campaign (D-491): an org chart, a process
/// description, the list of tools already in use. Read like a participant's attachment, but owned
/// by the campaign, not by an interview: the interviewer sees its summary as background, and the
/// analysis uses it as context only, never as evidence. Its bytes live under their own prefix
/// (`campaign-docs/<company>/<campaign>/<id>`), outside the per-session folders the storage sweep
/// reclaims.
model CampaignDocument {
  id            String    @id @default(cuid())
  companyId     String
  campaignId    String
  filename      String
  mime          String
  kind          String // document | image
  sizeBytes     Int       @default(0)
  storageKey    String    @default("")
  status        String    @default("pending") // pending | ready | failed
  error         String?
  summary       String?
  extractedText String?
  uploadedById  String?
  createdAt     DateTime  @default(now())
  ingestedAt    DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId, campaignId])
}

model UsageCounter {
  id          String   @id @default(cuid())
  companyId   String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key, windowStart])
  @@index([windowStart])
}

model Budget {
  id         String   @id @default(cuid())
  companyId  String
  scope      String // tenant | campaign | session
  scopeId    String
  limitCents Int
  period     String // month | total
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([scope, scopeId])
  @@index([companyId])
}

model LlmCall {
  id               String   @id @default(cuid())
  companyId        String
  purpose          String
  providerId       String
  model            String
  promptVersion    String?
  inputTokens      Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int
  latencyMs        Int
  status           String // ok | error | refused | budget_exceeded | aborted
  costCents        Float
  sessionId        String?
  campaignId       String?
  createdAt        DateTime @default(now())
  /// Time to the first streamed text event (NFR-01); null for calls that do not stream. Migration 0023.
  firstTokenMs     Int?
  /// Speech-to-text input, in seconds (D-220).
  audioSeconds     Float    @default(0)
  /// Characters sent to text-to-speech (D-220).
  ttsCharacters    Int      @default(0)
  /// The usage is our estimate (abandoned stream, died before a usage report), not the provider's (D-221).
  estimated        Boolean  @default(false)
  /// primary | fallback: which route served the call (D-228).
  routeTier        String   @default("primary")

  company  Company   @relation(fields: [companyId], references: [id])
  provider Provider  @relation(fields: [providerId], references: [id])
  session  Session?  @relation(fields: [sessionId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, purpose, createdAt])
  @@index([campaignId])
  @@index([sessionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  targetType String
  targetId   String
  diff       Json?
  createdAt  DateTime @default(now())
  /// Position in this tenant's chain, previous hash and own hash: filled by the insert trigger
  /// (migration 0019), never by the application. The table is append-only for every role (D-163).
  seq        Int      @default(0)
  prevHash   String   @default("")
  hash       String   @default("")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, seq])
  @@index([companyId, createdAt])
  @@index([companyId, action, createdAt])
}

/// One row per email the worker has sent or is sending, keyed by the caller's idempotency key, so
/// a job that is retried after the SMTP send succeeded does not send the message again (D-105).
model SentEmail {
  id             String    @id @default(cuid())
  companyId      String?
  idempotencyKey String    @unique
  /// sending | sent. A row left in `sending` past its lease is taken over by the next attempt.
  state          String    @default("sending")
  claimedAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([state, claimedAt])
  @@index([sentAt])
}

/// One row per alert key: the dedupe, rate-limit and history store behind `AlertPort`
/// (packages/core/src/alerts, D-90). `key` names the condition, not the occurrence, so the same
/// failing job or the same exhausted budget is one row whose `count` grows while it persists.
///
/// `companyId` is null for a platform condition (a full disk, a missing backup) and set for one
/// that belongs to a tenant, which is why this table needs the same nullable-companyId policy as
/// Provider and Route (migration 0014). The router reads and writes it in the system context,
/// because the key is global and a platform row is not writable under a tenant.
model OpsAlert {
  id         String    @id @default(cuid())
  key        String    @unique
  kind       String
  severity   String // info | warning | critical
  companyId  String?
  title      String
  message    String    @default("")
  count      Int       @default(1)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  /// Set when a notification was claimed for this key; cleared again if every channel failed, so
  /// the next occurrence retries at once instead of waiting out the repeat window.
  notifiedAt DateTime?
  resolvedAt DateTime?
  context    Json      @default("{}")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([kind, lastAt])
  @@index([companyId, lastAt])
}

/// The built-in error log (D-477): server and browser failures, grouped so a recurring fault is one
/// row whose `count` grows instead of a pile of copies. `groupKey` is the fingerprint (source, error
/// name, normalised message, route or top frame) together with the tenant, so every group belongs
/// to one tenant or, with `companyId` null, to the platform; that is what lets the table sit under
/// the same nullable-companyId policy as OpsAlert (migration 0028). `fingerprint` alone joins one
/// fault across tenants. Written and read only in the system context: the API's and the worker's
/// error recorders, and the platform operator's routes.
///
/// `hourly` counts occurrences per UTC hour (`"2026-10-21T13": n`) for the last eight days, so "in
/// the last 24 hours" and "in the last 7 days" stay derivable although only the newest occurrences
/// are kept. A new occurrence clears `resolvedAt`: a resolved fault that comes back is open again.
model ErrorGroup {
  id           String    @id @default(cuid())
  groupKey     String    @unique
  fingerprint  String
  companyId    String?
  source       String // api | worker | web | browser
  severity     String // error | warning
  name         String
  message      String
  route        String?
  jobName      String?
  count        Int       @default(1)
  hourly       Json      @default("{}")
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  occurrences ErrorOccurrence[]

  @@index([lastSeenAt])
  @@index([companyId, lastSeenAt])
  @@index([fingerprint])
}

/// One stored occurrence of an ErrorGroup; only the newest few per group are kept (D-477). Every
/// text field is redacted and truncated before it is written (packages/core/src/errorlog): no
/// request body, no header, no participant answer, no address. `userId` is a staff user and
/// `sessionId` a participant's interview, ids only.
model ErrorOccurrence {
  id         String   @id @default(cuid())
  groupId    String
  companyId  String?
  occurredAt DateTime @default(now())
  source     String
  severity   String
  name       String
  message    String
  stack      String?
  route      String?
  path       String?
  method     String?
  status     Int?
  requestId  String?
  userId     String?
  sessionId  String?
  release    String?
  userAgent  String?
  jobName    String?
  jobAttempt Int?
  jobFinal   Boolean?

  group   ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  company Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([groupId, occurredAt])
  @@index([occurredAt])
  @@index([companyId])
}
