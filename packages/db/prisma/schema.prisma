// Spec v1.1 section 9. Every tenant-owned row carries companyId (FR-01).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Tenancy and identity ----------

model Company {
  id                 String   @id @default(cuid())
  name               String
  region             String   @default("eu")
  monthlyBudgetCents Int      @default(0)
  status             String   @default("active") // active | suspended
  createdAt          DateTime @default(now())

  users        User[]
  participants Participant[]
  templates    InterviewTemplate[]
  campaigns    Campaign[]
  sessions     Session[]
  attachments  Attachment[]
  chunks       AttachmentChunk[]
  facts        Fact[]
  providers    Provider[]
  routes       Route[]
  budgets      Budget[]
  llmCalls     LlmCall[]
  auditLogs    AuditLog[]
}

model User {
  id        String   @id @default(cuid())
  companyId String
  email     String   @unique // lower-case, one tenant per address (D-84); a CHECK enforces the case
  name      String?
  role      String // platform_operator | admin | member
  createdAt DateTime @default(now())

  company      Company       @relation(fields: [companyId], references: [id])
  participants Participant[]
  sessions     Session[]     @relation("SessionOwner")
  campaigns    Campaign[]

  @@index([companyId])
}

/// A person taking part in a campaign. Anonymous participants have no user and only the
/// fields the template asked for (FR-04).
model Participant {
  id         String   @id @default(cuid())
  companyId  String
  campaignId String? // null for a person invited into a requirements session (contract 18)
  userId     String?
  fields     Json     @default("{}")
  tokenHash  String   @unique
  createdAt  DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  sessions Session[]

  @@index([companyId, campaignId])
}

// ---------- Templates (FR-60 to FR-66) ----------

model InterviewTemplate {
  id                String   @id @default(cuid())
  companyId         String? // null = platform seeded
  key               String
  version           Int      @default(1)
  name              String
  language          String   @default("en")
  objective         String
  privacyMode       String // identified | anonymous | participant_choice
  participantFields Json     @default("[]")
  pathSelection     String   @default("none") // none | technical_or_not
  contextBlock      Json     @default("[]")
  coverageAreas     Json     @default("[]")
  aiInstructions    String   @default("")
  adaptivity        Json     @default("{}")
  widgetPolicy      Json     @default("{}")
  issueDetection    Json     @default("{}")
  outputs           Json     @default("[]")
  analysisEnabled   Boolean  @default(false)
  chainToKey        String?
  chainMapping      Json?
  closingQuestion   String   @default("Is there anything important I did not ask about?")
  endSummary        Boolean  @default(true)
  maxTurns          Int      @default(60)
  maxAssistantChars Int      @default(600)
  status            String   @default("draft") // draft | published | archived
  createdById       String?
  createdAt         DateTime @default(now())

  company   Company?   @relation(fields: [companyId], references: [id])
  campaigns Campaign[]
  sessions  Session[]

  @@unique([companyId, key, version])
  @@index([companyId])
}

// ---------- Campaigns and sessions ----------

model Campaign {
  id                  String   @id @default(cuid())
  companyId           String
  templateId          String
  name                String
  participationMode   String // identified | anonymous | participant_choice
  linkTokenHash       String   @unique
  verification        String   @default("email_code") // invitation | email_code | open
  allowedEmailDomains Json     @default("[]")
  expiresAt           DateTime?
  maxTurns            Int      @default(60)
  completionThreshold Int      @default(5)
  weights             Json     @default("{}")
  status              String   @default("draft") // draft | open | analyzing | closed
  createdById         String
  createdAt           DateTime @default(now())
  invitations         Invitation[]
  emailHashes         CampaignEmailHash[]

  company      Company           @relation(fields: [companyId], references: [id])
  template     InterviewTemplate @relation(fields: [templateId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  participants Participant[]
  sessions     Session[]
  analyses     Analysis[]
  llmCalls     LlmCall[]

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, status, createdAt])
}

model Session {
  id             String    @id @default(cuid())
  companyId      String
  templateId     String
  campaignId     String?
  participantId  String?
  ownerUserId    String?
  sourceKind     String    @default("campaign") // campaign | text | handoff
  handoff        Json?
  title          String    @default("") // requirements sessions: the product or idea name
  specEdits      Json      @default("{}") // requirements sessions: owner edits by section key (FR-23)
  invitations    Json      @default("[]") // requirements sessions: external invitations (contract 18)
  status         String    @default("created") // created | consented | active | paused | completed | deleted
  consentVersion String?
  consentedAt    DateTime?
  state          Json      @default("{}")
  summary        String    @default("")
  path           String? // technical | nontechnical
  modePreference String    @default("chat") // chat | options | voice
  turnLockedAt   DateTime? // set while a turn is running; guards against concurrent turns
  templateVersion Int      @default(1)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  /// Last write to the row: every turn rewrites `state`, so this is the session's last activity (D-79).
  updatedAt      DateTime  @default(now()) @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  template    InterviewTemplate @relation(fields: [templateId], references: [id])
  campaign    Campaign?         @relation(fields: [campaignId], references: [id])
  participant Participant?      @relation(fields: [participantId], references: [id])
  owner       User?             @relation("SessionOwner", fields: [ownerUserId], references: [id])
  messages    Message[]
  events      SessionEvent[]
  attachments Attachment[]
  facts       Fact[]
  specs       SpecVersion[]
  llmCalls    LlmCall[]
  invitation  Invitation?

  @@index([companyId, campaignId])
  @@index([companyId, campaignId, status])
  @@index([companyId, ownerUserId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  seq       Int
  role           String // user | assistant
  modality       String   @default("text") // text | voice | file | widget
  content        String
  widget         Json? // Widget offered with an assistant message
  widgetResponse Json? // WidgetResponse recorded with a user message
  areaKey        String?
  createdAt      DateTime @default(now())

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([sessionId, seq])
}

/// Append-only (FR-51). state_delta, finding, attachment, admin_note, system.
model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
}

model Attachment {
  id            String   @id @default(cuid())
  companyId     String
  sessionId     String
  messageId     String?
  kind          String // audio | document | image
  filename      String
  mime          String
  sizeBytes     Int
  storageKey    String
  extractedText String?
  summary       String?
  createdAt     DateTime @default(now())

  // Ingestion is a job, so an attachment exists before its text does (FR-31). The participant is
  // shown this rather than an attachment that silently never becomes useful.
  status     String    @default("pending") // pending | ready | failed
  error      String?
  ingestedAt DateTime?

  // Audio only (FR-30). durationMs drives the player and the per-second transcription cost;
  // confidence is one of the three voice signals the spec asks to trace per turn.
  durationMs Int?
  confidence Float?

  company Company           @relation(fields: [companyId], references: [id])
  session Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message Message?          @relation(fields: [messageId], references: [id])
  chunks  AttachmentChunk[]

  @@index([companyId, sessionId])
  @@index([companyId, status])
}

/// One retrievable piece of an ingested document (FR-31). The interview carries the attachment's
/// summary in context and recalls chunks on demand, so a 40-page PDF costs a summary per turn
/// rather than 40 pages per turn.
///
/// `embedding` is null whenever no `embedding` route is configured, which is the common case on a
/// provider that serves no embedding models. Recall then scores the same chunk text lexically,
/// so the feature degrades rather than disappears.
model AttachmentChunk {
  id           String                       @id @default(cuid())
  companyId    String
  attachmentId String
  seq          Int
  text         String
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, seq])
  @@index([companyId, attachmentId])
}

// ---------- Facts, analysis, opportunities ----------

model Fact {
  id               String                      @id @default(cuid())
  companyId        String
  sessionId        String
  kind             String // task | process | information_flow | pain_point | opportunity_candidate | spec_field
  payload          Json
  embedding        Unsupported("vector(1536)")?
  extractorVersion String
  extractedAt      DateTime                    @default(now())
  /// Highest message sequence of the extraction batch that produced this fact. With `ordinal` it
  /// is the idempotency key: replaying a batch cannot write its facts twice (D-100).
  batchEndSeq      Int
  /// Position within that batch.
  ordinal          Int

  company  Company               @relation(fields: [companyId], references: [id])
  session  Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence OpportunityEvidence[]

  @@unique([sessionId, batchEndSeq, ordinal])
  @@index([companyId, sessionId])
}

model Analysis {
  id         String    @id @default(cuid())
  campaignId String
  version    Int
  status      String    @default("queued") // queued | running | done | failed
  preliminary Boolean   @default(false)
  stats       Json      @default("{}")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  campaign      Campaign      @relation(fields: [campaignId], references: [id])
  opportunities Opportunity[]
  reports       Report[]

  @@unique([campaignId, version])
}

model Opportunity {
  id            String   @id @default(cuid())
  analysisId    String
  title         String
  summary       String
  solutionClass String // ai | automation | software | process | none
  factors       Json // seven factors, each { score, rationale }
  rationale     String
  rankScore     Float
  status        String   @default("new") // new | shortlisted | promoted | dismissed
  clusterKey    String
  adminOverride Json?
  stats         Json     @default("{}") // ClusterStats
  dataNeeded    Json     @default("[]")
  risks         Json     @default("[]")
  whyNotAi      String?
  promotedSessionId String?
  createdAt     DateTime @default(now())

  analysis Analysis              @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  evidence OpportunityEvidence[]

  @@index([analysisId, rankScore])
}

model OpportunityEvidence {
  opportunityId String
  factId        String
  snippet       String
  anonymized    Boolean @default(true)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fact        Fact        @relation(fields: [factId], references: [id], onDelete: Cascade)

  @@id([opportunityId, factId])
}

model Report {
  id            String   @id @default(cuid())
  analysisId    String
  version       Int
  markdown      String
  sections      Json     @default("[]")
  pdfStorageKey String?
  createdAt     DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, version])
}

/// A generated specification (spec 05, contract 18). Versions are kept; reopening creates a new one.
model SpecVersion {
  id         String    @id @default(cuid())
  companyId  String
  sessionId  String
  version    Int
  label      String?
  status     String    @default("done") // queued | running | done | failed
  error      String?
  spec       Json // SpecDocument
  specMd     String
  bundle     Json // AgentBundle
  issues     Json      @default("[]") // Finding[] open at generation time
  stats      Json      @default("{}")
  createdBy  String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, version])
  @@index([companyId])
}

/// Personal one-time links and email-code bindings (FR-10, FR-04). One session per invitation.
model Invitation {
  id         String    @id @default(cuid())
  campaignId String
  emailHash  String // salted hash; the plain email is kept only when the campaign is identified
  email      String?
  tokenHash  String    @unique
  status     String    @default("pending") // pending | sent | opened | bound | revoked | expired
  sessionId  String?   @unique
  sentAt     DateTime?
  openedAt   DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session  Session? @relation(fields: [sessionId], references: [id])

  @@unique([campaignId, emailHash])
}

/// Uniqueness record for anonymous share links: proves an email responded without linking it to a session.
model CampaignEmailHash {
  campaignId String
  emailHash  String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, emailHash])
}

/// Short-lived email verification codes for share links.
model EmailCode {
  id         String   @id @default(cuid())
  campaignId String
  emailHash  String
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([campaignId, emailHash])
}

/// Settings catalog values by scope (packages/shared settings.ts defines keys and defaults).
model Setting {
  id        String   @id @default(cuid())
  scope     String // platform | tenant | template | campaign
  scopeId   String   @default("") // empty for platform
  key       String
  value     Json
  version   Int      @default(1)
  changedBy String?
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, key])
}

/// Pending Auth.js magic-link verification tokens (FR-01, D-56).
///
/// Platform-level, not tenant-owned: the token is minted from an email address alone, before
/// anyone knows which company it belongs to. So it carries no `companyId`, stays out of
/// `SCOPED_MODELS`, and is deliberately outside the row-level-security policy set in migration
/// 0008. The web app reaches it only through `/internal/auth/verification-tokens` on the API.
model VerificationToken {
  identifier String
  /// Already a hash. Auth.js hashes the magic-link token with AUTH_SECRET before handing it to
  /// the adapter: the plaintext goes in the email, the digest comes here. Do not hash it again,
  /// or `useVerificationToken` will never find the row it just wrote.
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

/// Tenant overrides and canaries of the versioned prompt files shipped in packages/ai.
model PromptVersion {
  id          String   @id @default(cuid())
  companyId   String?
  key         String
  version     Int
  body        String
  canaryShare Float    @default(0) // 0..1 share of sessions using this version
  active      Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@unique([companyId, key, version])
}

// ---------- Providers, routing, cost (FR-40 to FR-49) ----------

model Provider {
  id        String   @id @default(cuid())
  companyId String? // null = platform-level
  kind      String
  name      String
  baseUrl   String?
  apiKeyEnc String
  headers   Json     @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  company  Company?     @relation(fields: [companyId], references: [id])
  prices   ModelPrice[]
  routes   Route[]
  llmCalls LlmCall[]

  @@index([companyId])
}

model ModelPrice {
  id                 String   @id @default(cuid())
  providerId         String
  model              String
  inputPerMtok       Float
  cachedInputPerMtok Float
  outputPerMtok      Float
  source             String // seed | admin | provider
  updatedAt          DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
}

model Route {
  id              String  @id @default(cuid())
  companyId       String? // null = platform default
  purpose         String
  providerId      String
  model           String
  effort          String?
  maxOutputTokens Int
  batchAllowed    Boolean @default(false)

  company  Company? @relation(fields: [companyId], references: [id])
  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([companyId, purpose])
}

model Budget {
  id         String   @id @default(cuid())
  companyId  String
  scope      String // tenant | campaign | session
  scopeId    String
  limitCents Int
  period     String // month | total
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([scope, scopeId])
  @@index([companyId])
}

model LlmCall {
  id               String   @id @default(cuid())
  companyId        String
  purpose          String
  providerId       String
  model            String
  promptVersion    String?
  inputTokens      Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int
  latencyMs        Int
  status           String // ok | error | refused | budget_exceeded | aborted
  costCents        Float
  sessionId        String?
  campaignId       String?
  createdAt        DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id])
  provider Provider  @relation(fields: [providerId], references: [id])
  session  Session?  @relation(fields: [sessionId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, createdAt])
  @@index([campaignId])
  @@index([sessionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?
  action     String
  targetType String
  targetId   String
  diff       Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, action, createdAt])
}

/// One row per email the worker has sent or is sending, keyed by the caller's idempotency key, so
/// a job that is retried after the SMTP send succeeded does not send the message again (D-105).
model SentEmail {
  id             String    @id @default(cuid())
  companyId      String?
  idempotencyKey String    @unique
  /// sending | sent. A row left in `sending` past its lease is taken over by the next attempt.
  state          String    @default("sending")
  claimedAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([state, claimedAt])
  @@index([sentAt])
}
