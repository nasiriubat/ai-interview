# Resource limits for an 8 GB host: the defaults of compose.prod.yml, written down so that a host
# that was started on the 4 GB preset can go back by appending this file (deploy/generate-env.sh
# --size 8gb does it for a new install). The sum of the limits is about 7.5 GB, which includes the
# on-host Whisper model (api 2560M); the measured use under the full load run is under 1 GB without it.
POSTGRES_MEMORY_LIMIT=1536M
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=100
API_MEMORY_LIMIT=2560M
WORKER_MEMORY_LIMIT=1024M
WEB_MEMORY_LIMIT=768M
CADDY_MEMORY_LIMIT=256M
BACKUP_MEMORY_LIMIT=512M
KROKI_MEMORY_LIMIT=320M
KROKI_MERMAID_MEMORY_LIMIT=512M
