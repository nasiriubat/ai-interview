# Reverse proxy for the production stack. One public hostname, TLS obtained and renewed by Caddy.
#
# The API is deliberately absent from this file. The browser never talks to it: every call goes
# through the Next.js route handlers in apps/web/src/app/api/**, which attach the bearer token
# server-side (apps/web/src/lib/api/proxy.ts). Publishing the API would put a second origin on
# the internet that has to be CORS-configured, rate-limited and token-exposed for no gain.
#
# Every placeholder below is supplied by compose.yml, so none of them needs a default here.
# CADDY_LOCAL_CERTS is empty in production, which leaves Caddy on Let's Encrypt via ACME. A test
# run without a public domain sets it, and Caddy issues from its own internal CA instead. The only
# value Caddy accepts on line 15 is the literal directive `local_certs`, so the compose service
# normalizes `1`, `true` and friends to that before starting — write either in .env.
{
	email {$ACME_EMAIL}
	admin off
	{$CADDY_LOCAL_CERTS}

	# Slow-client defences (S6, D-87). A request that dribbles its headers or body holds a
	# connection, and a socket, for as long as it likes unless the server says otherwise. The
	# body timeout is generous because recordings and documents are up to 50 MB over mobile links.
	servers {
		timeouts {
			read_header 10s
			read_body 3m
			idle 2m
		}

		# Behind Cloudflare the peer is a Cloudflare edge, so the client is the one it names in
		# CF-Connecting-IP. Only a peer inside Cloudflare's published ranges is believed; a direct
		# connection from anywhere else keeps its own address, so the header cannot be forged.
		# {client_ip} below is that result. https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

# Liveness for the container healthcheck only; this port is not published to the host.
:2020 {
	respond /healthz "ok" 200
	respond "not found" 404
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	# Maintenance (D-96). deploy/upgrade.sh creates /maintenance/on in the caddy_maint volume
	# before it switches versions and removes it once the post-switch checks pass, so for the ten
	# seconds or so while api and web restart, a participant sees a page that says so and a
	# Retry-After, not a proxy error. The flag is a file, not configuration, so toggling it is not
	# a Caddy reload and cannot itself break the site.
	@maintenance file {
		root /maintenance
		try_files /on
	}
	handle @maintenance {
		header Retry-After "30"
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Back in a minute</title><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:20vh auto;padding:0 1rem;line-height:1.5"><h1>Back in a minute</h1><p>We are updating the service. Your answers so far are saved; please reload this page in a minute.</p><p lang="fi">Päivitämme palvelua. Antamasi vastaukset on tallennettu; lataa sivu uudelleen minuutin kuluttua.</p></body></html>` 503
	}

	# Live voice (FR-30a) is the one path that reaches the API directly.
	#
	# Everything else goes through the Next.js proxy, which is what keeps the API off the internet.
	# A Next.js route handler cannot upgrade a connection, so a WebSocket has nowhere to be proxied
	# to. This forwards one exact path, and it is not a hole: the API authenticates it with the same
	# `aidp_participant` cookie the web app set — same site, so the browser attaches it — and the
	# socket can do nothing a participant could not already do over HTTP.
	@voice path /api/v1/p/session/live
	handle @voice {
		reverse_proxy api:4000 {
			flush_interval -1
			# The only value the API believes as the client address (TRUST_PROXY_HOPS=1). Written
			# explicitly, from the connection (or the Cloudflare edge that made it), so it holds whatever the client sent and
			# whatever Caddy's defaults are in a later version (S1, D-82).
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Host {host}
		}
	}

	# Request bodies are bounded here, before they reach the web process (S6, D-87). The routes that
	# carry a file may take up to the platform maximum of 50 MB plus multipart framing: a
	# participant's attachment, recorded answer and dictation; the requirements owner's attachments
	# and dictation; a campaign's background documents (D-483, D-490, D-491). Every other route is
	# JSON and gets 2 MB, the same ceiling the API itself enforces. The matchers are complements of
	# one another so exactly one limit applies to a request: stacked limits would let the small one
	# refuse the upload. Keep the list in step with `bodyLimitFor` in apps/web/src/lib/api/proxy.ts.
	@uploads path_regexp upload ^/api/(participant/p/session/(attachments|voice-turns|transcribe)|staff/(requirements/[A-Za-z0-9_-]+/(attachments|transcribe)|campaigns/[A-Za-z0-9_-]+/documents))$
	@bounded not path_regexp upload ^/api/(participant/p/session/(attachments|voice-turns|transcribe)|staff/(requirements/[A-Za-z0-9_-]+/(attachments|transcribe)|campaigns/[A-Za-z0-9_-]+/documents))$
	request_body @uploads {
		max_size 55MB
	}
	request_body @bounded {
		max_size 2MB
	}

	# Server-sent events carry the interview stream; buffering them would stall every turn.
	reverse_proxy web:3000 {
		flush_interval -1
		# One address, the client's, replacing anything the client sent. The web app forwards
		# it to the API as the rate-limit identity of an anonymous caller (S1, D-82).
		header_up X-Forwarded-For {client_ip}
		# Once Cloudflare is a trusted proxy, Caddy would pass on whatever X-Forwarded-Host the client
		# sent; the web app builds redirects from it. The host Caddy answered on is the only true one.
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing frames this app (the CSP says frame-ancestors 'none' as well), and the
		# microphone is the one device permission voice needs (A3, D-165).
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# The access log is where a participant's link token would otherwise live for as long as logs
	# are kept (D-223). Tokens are path segments (`/p/<token>`, `/p/r/<token>`), so the path is
	# rewritten, and the values of the query-string keys that carry a secret (the magic-link
	# `token`, the verification `code`, `email`, `callbackUrl`) are replaced. 16 characters is well
	# under any token this app issues and well over every fixed route name (`/p/session`), so only
	# tokens match.
	#
	# One `multi_regexp` and not a `regexp` plus a `query` filter on the same field: Caddy refuses
	# to mix filter types on one field ("cannot mix regexp filters with other filter types"), which
	# is what this block used to do. The whole file failed to load and Caddy restarted in a loop,
	# so no production stack with this file could ever have served a request (found by the
	# full-stack drill, 2026-10-14; deploy/test/images.test.sh holds the shape).
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri multi_regexp {
					regexp (/p/(?:r/)?)[A-Za-z0-9_-]{16,} $1<token>
					regexp ([?&](?:token|code|email|callbackUrl)=)[^&]* ${1}REDACTED
				}
			}
		}
	}
}
