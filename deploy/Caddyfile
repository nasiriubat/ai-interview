# Reverse proxy for the production stack. One public hostname, TLS obtained and renewed by Caddy.
#
# The API is deliberately absent from this file. The browser never talks to it: every call goes
# through the Next.js route handlers in apps/web/src/app/api/**, which attach the bearer token
# server-side (apps/web/src/lib/api/proxy.ts). Publishing the API would put a second origin on
# the internet that has to be CORS-configured, rate-limited and token-exposed for no gain.
#
# Every placeholder below is supplied by compose.prod.yml, so none of them needs a default here.
# CADDY_LOCAL_CERTS is empty in production, which leaves Caddy on Let's Encrypt via ACME. A test
# run without a public domain sets it, and Caddy issues from its own internal CA instead. The only
# value Caddy accepts on line 15 is the literal directive `local_certs`, so the compose service
# normalizes `1`, `true` and friends to that before starting — write either in deploy/.env.
{
	email {$ACME_EMAIL}
	admin off
	{$CADDY_LOCAL_CERTS}

	# Slow-client defences (S6, D-87). A request that dribbles its headers or body holds a
	# connection, and a socket, for as long as it likes unless the server says otherwise. The
	# body timeout is generous because recordings and documents are up to 50 MB over mobile links.
	servers {
		timeouts {
			read_header 10s
			read_body 3m
			idle 2m
		}
	}
}

# Liveness for the container healthcheck only; this port is not published to the host.
:2020 {
	respond /healthz "ok" 200
	respond "not found" 404
}

{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	# Maintenance (D-96). deploy/upgrade.sh creates /maintenance/on in the caddy_maint volume
	# before it switches versions and removes it once the post-switch checks pass, so for the ten
	# seconds or so while api and web restart, a participant sees a page that says so and a
	# Retry-After, not a proxy error. The flag is a file, not configuration, so toggling it is not
	# a Caddy reload and cannot itself break the site.
	@maintenance file {
		root /maintenance
		try_files /on
	}
	handle @maintenance {
		header Retry-After "30"
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Back in a minute</title><body style="font-family:system-ui,sans-serif;max-width:32rem;margin:20vh auto;padding:0 1rem;line-height:1.5"><h1>Back in a minute</h1><p>We are updating the service. Your answers so far are saved; please reload this page in a minute.</p><p lang="fi">Päivitämme palvelua. Antamasi vastaukset on tallennettu; lataa sivu uudelleen minuutin kuluttua.</p></body></html>` 503
	}

	# Live voice (FR-30a) is the one path that reaches the API directly.
	#
	# Everything else goes through the Next.js proxy, which is what keeps the API off the internet.
	# A Next.js route handler cannot upgrade a connection, so a WebSocket has nowhere to be proxied
	# to. This forwards one exact path, and it is not a hole: the API authenticates it with the same
	# `aidp_participant` cookie the web app set — same site, so the browser attaches it — and the
	# socket can do nothing a participant could not already do over HTTP.
	@voice path /api/v1/p/session/live
	handle @voice {
		reverse_proxy api:4000 {
			flush_interval -1
			# The only value the API believes as the client address (TRUST_PROXY_HOPS=1). Written
			# explicitly, from the connection itself, so it holds whatever the client sent and
			# whatever Caddy's defaults are in a later version (S1, D-82).
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Request bodies are bounded here, before they reach the web process (S6, D-87). Two uploads
	# may carry a file, up to the platform maximum of 50 MB plus multipart framing; every other
	# route is JSON and gets 2 MB, the same ceiling the API itself enforces. The matchers are
	# complements of one another so exactly one limit applies to a request: stacked limits would
	# let the small one refuse the upload.
	@uploads path /api/participant/p/session/attachments /api/participant/p/session/voice-turns
	@bounded not path /api/participant/p/session/attachments /api/participant/p/session/voice-turns
	request_body @uploads {
		max_size 55MB
	}
	request_body @bounded {
		max_size 2MB
	}

	# Server-sent events carry the interview stream; buffering them would stall every turn.
	reverse_proxy web:3000 {
		flush_interval -1
		# One address, the client's, replacing anything the client sent. The web app forwards
		# it to the API as the rate-limit identity of an anonymous caller (S1, D-82).
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing frames this app (the CSP says frame-ancestors 'none' as well), and the
		# microphone is the one device permission voice needs (A3, D-165).
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# The access log is where a participant's link token would otherwise live for as long as logs
	# are kept (D-223). Tokens are path segments (`/p/<token>`, `/p/r/<token>`), so the path is
	# rewritten, and the keys of the query string that carry a secret (the magic-link `token`, the
	# verification `code`) are removed. 16 characters is well under any token this app issues and
	# well over every fixed route name (`/p/session`), so only tokens match.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp (/p/(?:r/)?)[A-Za-z0-9_-]{16,} $1<token>
				request>uri query {
					delete token
					delete code
					delete email
					delete callbackUrl
				}
			}
		}
	}
}
