#!/bin/bash
# `docker compose` for the production stack, with the right files and project, from anywhere.
#
#   deploy/dc ps
#   deploy/dc logs -f api
#   deploy/dc exec -T backup /usr/local/bin/backup.sh once
#
# Three things every invocation needs and nobody should have to remember: the compose file, the
# settings and secrets in the repository-root .env (the one env file, D-450), and deploy/versions.env, which holds the image tag the stack is running
# (written by upgrade.sh and rollback.sh, never by hand). Without the last one compose cannot name
# an image. This is the `dc` alias DEPLOY.md and OPERATIONS.md use.
#
# Overrides, for a non-default layout: COMPOSE_FILE_PATH, ENV_FILE_PATH, VERSIONS_FILE_PATH, and
# COMPOSE_OVERRIDE_FILES (space separated; the full-stack drill's fake provider overlay).
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
AIDP_DEPLOY_DIR="$here"
# compose_file, env_file (<repo>/.env), versions_file and refuse_legacy_env.
# shellcheck source=deploy/lib/lib.sh
. "$here/lib/lib.sh"

refuse_legacy_env dc
[ -f "$env_file" ] || { echo "dc: no $env_file; run deploy/generate-env.sh first" >&2; exit 1; }
args=(-f "$compose_file")
for extra in ${COMPOSE_OVERRIDE_FILES:-}; do args+=(-f "$extra"); done
args+=(--env-file "$env_file")
if [ -f "$versions_file" ]; then
	args+=(--env-file "$versions_file")
elif [ -z "${AIDP_VERSION:-}" ]; then
	echo "dc: no $versions_file and no AIDP_VERSION; run deploy/upgrade.sh to build and record a version" >&2
	exit 1
fi

exec docker compose "${args[@]}" "$@"
