# Installed by deploy/firewall/install.sh. Re-applies the Cloudflare-only rule after Docker starts.
[Unit]
Description=AI Discovery Platform: only Cloudflare may reach the published HTTPS port
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@REPO@/deploy/firewall/cloudflare-only.sh apply
ExecStop=@REPO@/deploy/firewall/cloudflare-only.sh remove

[Install]
WantedBy=multi-user.target
