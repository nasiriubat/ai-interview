  "turns": [
    {
      "n": 1,
      "text": "I run IT for a hundred person company, it is me and one part time colleague.",
      "labels": {
        "requirements": [],
        "facts": [],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 2,
      "text": "Mornings are tickets and password resets, afternoons are updates and onboarding laptops.",
      "labels": {
        "requirements": [],
        "facts": [],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 3,
      "text": "Password resets are the bulk of tickets, about fifteen a week, each by hand in the directory.",
      "labels": {
        "requirements": [],
        "facts": ["T1"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 4,
      "text": "Every new hire needs a laptop set up from a checklist, which takes a whole afternoon.",
      "labels": {
        "requirements": [],
        "facts": ["T2"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 5,
      "text": "Patching the servers is a monthly weekend job done by hand over remote shell.",
      "labels": {
        "requirements": [],
        "facts": ["T3"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 6,
      "text": "Once a quarter I reconcile software licenses from three spreadsheets.",
      "labels": {
        "requirements": [],
        "facts": ["T4"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 7,
      "text": "Every morning I open the backup console to see whether last night's jobs passed.",
      "labels": {
        "requirements": [],
        "facts": ["T5"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 8,
      "text": "Access reviews are a yearly export from five systems that I merge into one sheet.",
      "labels": {
        "requirements": [],
        "facts": ["T6"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 9,
      "text": "HR emails me new hire details and I copy them into the directory and the ticket.",
      "labels": {
        "requirements": [],
        "facts": ["I1"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 10,
      "text": "Managers ask for access in the chat channel, so requests get lost.",
      "labels": {
        "requirements": [],
        "facts": ["I2"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 11,
      "text": "Requests get lost in chat and I create the tickets late, so people chase me.",
      "labels": {
        "requirements": [],
        "facts": ["P1"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
    {
      "n": 12,
      "text": "If I am ill nothing gets done because everything depends on me.",
      "labels": {
        "requirements": [],
        "facts": ["P2"],
        "rescopes": [],
        "offTopic": false,
        "sections": []
      }
    },
