# Database (docker compose up -d starts a local Postgres)
DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery

# Platform key used to encrypt provider API keys at rest (32 bytes, base64)
PLATFORM_ENCRYPTION_KEY=

# Optional bootstrap providers. Everything here can also be configured in the admin UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LITELLM_BASE_URL=
LITELLM_API_KEY=
