# The one environment file of this repository, for development AND production (D-450). Copy it to
# .env in the repository root and fill it in; never commit .env.
#
#   development:  cp .env.example .env            then fill PLATFORM_ENCRYPTION_KEY and AUTH_SECRET
#   production:   deploy/generate-env.sh <host> <email>   writes .env with fresh secrets (key names
#                 only are printed) and refuses to overwrite an existing one without --force
#
# Who reads it:
#   development  `pnpm stack:up` (docker compose, every service), and on the host the API, the
#                worker, the database tools and `next dev` (through scripts/with-env.mjs). A
#                variable already set in the shell wins over this file. Tests and `pnpm check`
#                never read it.
#   production   deploy/dc, upgrade.sh, rollback.sh and restore.sh pass it to compose with
#                --env-file. deploy/compose.yml names every variable a service gets, so a missing
#                required one stops the stack with its name (docs/DEPLOY.md). An install made before
#                D-450, with its settings under deploy/, is told by deploy/dc to move them here.
#
# Sections: 1. required everywhere  2. required for production only  3. optional, everywhere
#           4. optional, production only  5. development defaults (production sets these itself).
# Lines that start with `# KEY=` are production-only: they stay commented in a development file, so
# the development stack is not renamed or reconfigured by a production value.
#
# Moving from the old apps/api/.env, or from one EMAIL_SMTP_URL? `pnpm env:migrate` (key names only).
#
# Each variable is tagged:
#   [required]   the stack does not work without it
#   [bootstrap]  read once, on first boot, to seed data (an operator, a tenant, a provider). Changing
#                it later does nothing; the admin is where it is changed after that
#   [fallback]   used only while the matching admin setting is empty. A value set in the admin wins
#   [runtime]    read from the environment every start; there is no admin setting for it
#   [web]        read by the Next.js web app

# === 1. Required, development and production =====================================================

# [required] 32 random bytes, base64: openssl rand -base64 32. Encrypts provider keys and SMTP
# secrets stored by the admin. Lose it and those stored secrets are unreadable; never regenerate it
# on a live install (docs/DEPLOY.md, "Secrets you cannot casually rotate").
PLATFORM_ENCRYPTION_KEY=
# [required] Auth.js session secret, shared by the API and the web app: openssl rand -base64 32.
AUTH_SECRET=
# [required in production] Gives the app_api role a login; the API and worker connect as it.
# Optional in development, which connects as the owner (docs/RUNNING.md, "Tenancy").
APP_DB_PASSWORD=

# --- First sign-in (bootstrap) -------------------------------------------------------------------
# There is NO password. Sign-in is a one-time link sent by email (or Google). In development:
#   1. open http://localhost:3000/auth/signin and enter BOOTSTRAP_ADMIN_EMAIL
#   2. open Mailpit at http://localhost:8025 and click the link in the message
# [bootstrap] BOOTSTRAP_OPERATOR_EMAIL signs in to the platform pages (providers, tenants, health).
BOOTSTRAP_OPERATOR_EMAIL=admin@example.test
# [bootstrap] The first tenant's admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# [bootstrap] The first tenant's name.
BOOTSTRAP_TENANT_NAME=First tenant

# --- Email: the mail relay (required in production) ----------------------------------------------
# [fallback] The deployment's mail relay: the same fields as the admin's mail server form (D-445).
# Used for sign-in links (the web app), and by the API and worker whenever the admin settings
# email.smtpUrl / email.from are empty. Write each value as your mail provider gives it; nothing is
# URL-encoded. A password with spaces, #, $ or quotes goes in single quotes: SMTP_PASSWORD='p@ss w#rd'.
# Production refuses to start without SMTP_HOST (or the deprecated EMAIL_SMTP_URL), because nobody
# can sign in without one. Empty SMTP_HOST in development logs emails to the console (the API) or
# uses Mailpit on localhost:1025 (the web app); `pnpm stack:up` points everything at Mailpit itself.
#
# SMTP_HOST      the server name only, e.g. smtp.example.com
SMTP_HOST=
# SMTP_PORT      e.g. 587. Empty uses the usual port for the security: starttls 587, tls 465, none 25
SMTP_PORT=
# SMTP_SECURITY  starttls (default, port 587), tls (implicit TLS, often called SSL, port 465) or none
SMTP_SECURITY=starttls
# SMTP_USER, SMTP_PASSWORD  the relay's login, e.g. apikey or relay@example.com. Leave both empty
# for a relay without one.
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM     the sender address; production: no-reply@<your host>
EMAIL_FROM=no-reply@example.com
# [deprecated] The one-URL form, still read only when SMTP_HOST is empty, so existing installs keep
# working. `pnpm env:migrate` splits it into the variables above. EMAIL_SERVER was the web app's
# name for the same value and is read after it.
# EMAIL_SMTP_URL=
# EMAIL_SERVER=

# === 2. Required for production only (deploy/generate-env.sh writes all of these) ==================

# Names the volumes (aidp_pgdata, aidp_backups ...). An install made before this setting existed
# has volumes called deploy_pgdata and must say COMPOSE_PROJECT_NAME=deploy; upgrade.sh checks.
# Commented here: in development it would rename the development stack.
# COMPOSE_PROJECT_NAME=aidp
# The public hostname DNS points at this server, and the Let's Encrypt contact.
# PUBLIC_HOSTNAME=pilot.example.com
# ACME_EMAIL=ops@example.com
# The database owner's password: hex (openssl rand -hex 24), it goes inside a connection URL.
# POSTGRES_PASSWORD=
# Backup encryption (D-95), written by deploy/backup/ensure-backup-key.sh. The recipient encrypts,
# the identity decrypts: lose the identity and every backup is unreadable. Copy this file off the host.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY=AGE-SECRET-KEY-...

# === 3. Optional, development and production ======================================================

# --- Model providers (bootstrap) -----------------------------------------------------------------
# [bootstrap] A key here creates a platform provider with default routes on first boot, and is
# not read again. After that, manage providers in the admin (Providers). At least one is needed
# for live interviews.
ANTHROPIC_API_KEY=
# Also bootstraps speech (transcription, text to speech) and embeddings, which Anthropic and
# OpenRouter cannot do.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# [runtime] Point OpenAI-compatible calls at another endpoint (an EU region, a proxy).
OPENAI_BASE_URL=
# [runtime] How long an on-server Whisper model stays in memory after the last recording. Empty
# uses the default.
SPEECH_MODEL_IDLE_MINUTES=
# [runtime] Outbound model-call limits in milliseconds (packages/ai/src/providers/resilience.ts).
# Empty keeps the defaults: 120000 total, 20000 to first token, 30000 idle, 2 retries. Raise the
# first two for a slow self-hosted gateway.
PROVIDER_TIMEOUT_MS=
PROVIDER_FIRST_TOKEN_TIMEOUT_MS=
PROVIDER_IDLE_TIMEOUT_MS=
PROVIDER_MAX_RETRIES=

# --- Sign-in and secrets -------------------------------------------------------------------------
# [web] Optional Google sign-in for staff (Auth.js reads these names itself).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# [runtime] Only during a rotation: the key being retired (docs/OPERATIONS.md, crypto.rekey).
PLATFORM_ENCRYPTION_KEY_PREVIOUS=

# --- Logs, traces, network -----------------------------------------------------------------------
# [runtime]
LOG_LEVEL=info
# Empty disables trace export (the API and the worker both export). With the observability
# profile (deploy/observability) it is http://tempo:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Hostnames a platform provider may reach on a private address, e.g. litellm,kroki-mermaid.
# Production defaults to kroki-mermaid when unset.
EGRESS_ALLOW_HOSTS=
# Diagram renderer for PDF export, e.g. http://kroki-mermaid:8002; empty prints diagrams as source.
# Production uses the bundled renderer when this is UNSET; an empty value there turns it off.
KROKI_URL=

# --- Operator alerts (docs/OPERATIONS.md) --------------------------------------------------------
# [runtime] Both optional; with neither, an alert still lands in the OpsAlert table and the
# operator address falls back to BOOTSTRAP_OPERATOR_EMAIL. The settings screen (Operations alerts)
# overrides these once someone has set it.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=                  # an ntfy topic URL, a Slack incoming webhook, or a generic JSON endpoint
ALERT_WEBHOOK_FORMAT=               # ntfy | slack | generic (default ntfy)

# --- Pilot requests (docs/DEPLOY.md, "Pilot requests") -------------------------------------------
# [runtime] Where the public "Request a pilot" form (/pilot) emails each request, Reply-To set to
# the requester. The operator's settings screen (Sales: sales.pilotRequestEmail) wins once set.
# Empty falls back to the alert address (ops.alertEmail, then ALERT_EMAIL); with none of them the
# form answers "try again later" and nothing is sent. Mail goes through the SMTP_* relay.
PILOT_REQUEST_EMAIL=

# === 4. Optional, production only =================================================================

# --- Backups (docs/OPERATIONS.md) ----------------------------------------------------------------
# Container clock (UTC); a comma list runs it more than once a day.
# BACKUP_AT=03:20
# BACKUP_RETENTION_DAYS=14
# The backup is reported unhealthy, and alerted, when the last success is older than this.
# BACKUP_MAX_AGE_HOURS=26
# The weekly restore drill (D-227): `off` disables it; day 1-7 (Monday is 1) and time.
# BACKUP_DRILL=on
# BACKUP_DRILL_DAY=7
# BACKUP_DRILL_AT=04:40
# Offsite copy of the (already encrypted) backups; empty means none. rclone reads the remote from
# these variables: name it 'offsite', give it a type and credentials, point RCLONE_REMOTE at a
# bucket. S3-compatible (Hetzner, Scaleway): TYPE=s3, PROVIDER=Other, ENDPOINT, ACCESS_KEY_ID,
# SECRET_ACCESS_KEY (REGION if the provider wants one). Backblaze B2: TYPE=b2, ACCOUNT, KEY.
# RCLONE_REMOTE=offsite:my-aidp-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://fsn1.your-objectstorage.com
# RCLONE_CONFIG_OFFSITE_REGION=
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ACCOUNT=
# RCLONE_CONFIG_OFFSITE_KEY=

# --- Edge (Caddy) and the web app ----------------------------------------------------------------
# Published ports; HTTPS_PORT also goes into the public URLs when it is not 443.
# HTTP_PORT=80
# HTTPS_PORT=443
# Publish on these host ports (or addr:port) instead, without changing the public URL: behind a
# CDN that forwards 443 to another port (docs/DEPLOY.md, "Behind Cloudflare").
# HTTP_BIND=127.0.0.1:18080
# HTTPS_BIND=8000
# Empty for Let's Encrypt. `local_certs` (or 1/true) only to test without a public domain.
# CADDY_LOCAL_CERTS=
# The Content-Security-Policy blocks (enforce); `report` is the escape hatch (D-264).
# CSP_MODE=enforce
# People a minute per client address on the link routes (D-310).
# RATE_LIMIT_PUBLIC_MAX=120

# --- Resource limits (deploy/generate-env.sh --size 4gb|8gb appends deploy/sizes/<size>.env) -----
# Ceilings for each container; the compose defaults are the 8 GB preset.
# POSTGRES_MEMORY_LIMIT=
# POSTGRES_SHARED_BUFFERS=
# POSTGRES_MAX_CONNECTIONS=
# API_MEMORY_LIMIT=
# CPUs the API may use (default 1.5); on-server transcription speeds up with more. Its threads
# follow this unless SPEECH_MODEL_THREADS says otherwise.
# API_CPU_LIMIT=
# SPEECH_MODEL_THREADS=
# Whisper engines transcribing side by side (default 1). Two serve a burst of recordings about a
# quarter faster on the same CPUs; each needs about 2.3 GB of API_MEMORY_LIMIT (D-494).
# SPEECH_WORKERS=
# WORKER_MEMORY_LIMIT=
# WEB_MEMORY_LIMIT=
# CADDY_MEMORY_LIMIT=
# BACKUP_MEMORY_LIMIT=
# KROKI_MERMAID_MEMORY_LIMIT=

# --- Observability profile (deploy/observability/README.md) --------------------------------------
# GRAFANA_ADMIN_PASSWORD=

# === 5. Development defaults (deploy/compose.yml sets each of these itself) ========================

# [required] Host-side connection (docker compose overrides it with the in-network address).
# Development connects as the owner, which bypasses row-level security; production connects as
# app_api.
DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery

# --- Web app -------------------------------------------------------------------------------------
# [web] Base URL of the API (without /api/v1), used by server components and route handlers.
NEXT_PUBLIC_API_URL=http://localhost:4000
# [web] Live voice is the one call the browser makes itself (a WebSocket cannot go through the
# Next.js proxy). In production Caddy serves it on the same origin and this is empty. In
# development the API is on another port, so point it there; ws:// locally, wss:// behind TLS.
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:4000/api/v1/p/session/live
# [web] Public landing page: where "Request a workspace" writes to. Empty shows sign-in only.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- API process ---------------------------------------------------------------------------------
# [runtime] Production derives the origins from PUBLIC_HOSTNAME.
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Serves Prometheus /metrics on that port (the worker uses +1, e.g. 9464 and 9465); empty or 0 is off.
METRICS_PORT=
# The shared status volume (backup status, worker heartbeat, erasure ledger); empty in development.
OPS_STATE_DIR=
# The running release, shown on the operator health page (production: deploy/versions.env).
AIDP_VERSION=
# Where the on-server Whisper models are cached. Empty uses the default.
MODEL_CACHE_DIR=

# --- Network security (docs/DEPLOY.md, "Who may connect to what") --------------------------------
# [runtime]
TRUST_PROXY_HOPS=1                  # proxies in front of the API that write X-Forwarded-For
EGRESS_MODE=strict                  # permissive is for tests and is refused in production
