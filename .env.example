# Root environment for `docker compose` and local tooling. Copy to .env and fill in; never commit .env.
# The API and worker read apps/api/.env (copy apps/api/.env.example) for the full list of settings.

DATABASE_URL=postgresql://app:app@localhost:5432/ai_discovery
PLATFORM_ENCRYPTION_KEY=        # openssl rand -base64 32

# Optional provider keys; at least one is needed for live interviews (a key can also be added later
# in the admin under Providers).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# First sign-in. There is NO password: sign-in is a one-time link sent by email (or Google).
# With `pnpm stack:up` emails are caught by Mailpit at http://localhost:8025.
#   1. open http://localhost:3000/auth/signin and enter BOOTSTRAP_ADMIN_EMAIL
#   2. open http://localhost:8025 and click the link in the message
BOOTSTRAP_OPERATOR_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_TENANT_NAME=First tenant
